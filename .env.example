# Copy to .env and fill in. Never commit .env.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# WhatsApp sender. The upgraded account uses the Twilio sandbox number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MOM_WHATSAPP_TO=whatsapp:+17372353170
TWILIO_CONTENT_SID=HXb5b62575e6e4ff6129ad7c8efe1f983e

# Placeholders for that sandbox template. Names must match the template.
TWILIO_CONTENT_VARIABLES={"1":"12/1","2":"3pm"}

OPENAI_API_KEY=

# Optional (non-secret)
# OPENAI_MODEL=gpt-4o-mini
# Public tunnel origin, if the Host header seen by Flask differs from the URL Twilio calls.
# PUBLIC_BASE_URL=https://<tunnel-host>
# Set to 1 only to test from another joined sandbox participant.
# ALLOW_ANY_SENDER=1

# Optional, for scripts.autopay_demo --whatsapp only (bank stays simulated)
# STEADY_TRUSTED_WHATSAPP_TO=whatsapp:+<authorized-family-test-phone>
# Approved no-variable template inviting the user to reply HI. Not an appointment template.
# STEADY_WAKE_TEMPLATE_SID=HX...
# Optional stable operator access token, at least 16 characters; process environment.
# STEADY_DEMO_TOKEN=
